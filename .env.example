PORT=8000
NODE_ENV=production

# Google Gemini API Key (optional - system falls back to deterministic rule parser & fast ranker if absent or invalid)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Atlas Connection (optional - system falls back to in-memory local standards dataset if offline)
MONGODB_URI=
MONGODB_DB=bis_procurement

# BIS Live Portal Scraping (set to true to enable asynchronous Playwright discovery in the background)
ENABLE_BIS_LIVE=false
BIS_TIMEOUT_MS=8000
